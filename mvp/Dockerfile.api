FROM node:24-bookworm-slim

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=3001 \
    DATABASE_PATH=/var/lib/gratificai/gratificai.sqlite

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server/app.mjs server/index.mjs server/bootstrap.mjs ./server/
COPY src/domain.ts src/ml.ts ./src/

RUN mkdir -p /var/lib/gratificai && chown node:node /var/lib/gratificai
USER node

VOLUME ["/var/lib/gratificai"]
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:3001/api/health').then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "server/index.mjs"]
